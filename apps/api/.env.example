# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://medicore_user:medicore_pass@localhost:5433/medicore_db
DB_POOL_MAX=20
DB_SSL=false

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION — min 32 random chars
JWT_SECRET=medicore_dev_secret_change_in_production_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001

# ── Frontend URL ──────────────────────────────────────────────
WEB_URL=http://localhost:3001

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_MAX=500
RATE_LIMIT_AUTH_MAX=20

# ── Email (dev: MailHog, prod: SMTP) ──────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@medicore.local
SMTP_SECURE=false

# ── SMS (Twilio) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Push (Firebase) ───────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Uploads ───────────────────────────────────────────────────
UPLOAD_MAX_MB=10
