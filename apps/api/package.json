{
  "name": "@medicore/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev":        "tsx watch src/main.ts",
    "build":      "tsc",
    "start":      "node dist/main.js",
    "test":       "jest",
    "lint":       "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:seed":    "tsx src/infrastructure/database/seed.ts"
  },
  "dependencies": {
    "express":            "^4.18.0",
    "@types/express":     "^4.17.0",
    "zod":                "^3.22.0",
    "jsonwebtoken":       "^9.0.0",
    "bcrypt":             "^5.1.0",
    "pg":                 "^8.11.0",
    "ioredis":            "^5.3.0",
    "socket.io":          "^4.6.0",
    "bullmq":             "^5.0.0",
    "winston":            "^3.11.0",
    "dotenv":             "^16.3.0",
    "cors":               "^2.8.5",
    "helmet":             "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "uuid":               "^9.0.0",
    "@medicore/shared-types":      "workspace:*",
    "@medicore/shared-validators": "workspace:*",
    "@medicore/shared-constants":  "workspace:*"
  },
  "devDependencies": {
    "typescript":            "^5.0.0",
    "tsx":                   "^4.0.0",
    "jest":                  "^29.0.0",
    "ts-jest":               "^29.0.0",
    "@types/node":           "^20.0.0",
    "@types/jsonwebtoken":   "^9.0.0",
    "@types/bcrypt":         "^5.0.0",
    "@types/pg":             "^8.0.0",
    "@types/cors":           "^2.8.0",
    "@types/uuid":           "^9.0.0"
  }
}
