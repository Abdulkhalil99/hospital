{
  "name": "medicore",
  "private": true,
  "scripts": {
    "dev":        "turbo run dev",
    "build":      "turbo run build",
    "test":       "turbo run test",
    "lint":       "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm --filter @medicore/api run db:migrate",
    "db:seed":    "pnpm --filter @medicore/api run db:seed"
  },
  "devDependencies": {
    "turbo":                            "^2.0.0",
    "prettier":                         "^3.0.0",
    "eslint":                           "^8.0.0",
    "@typescript-eslint/parser":        "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
